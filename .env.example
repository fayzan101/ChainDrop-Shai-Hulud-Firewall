# SentryHulud environment (template)

# LLM (stages 5 and 7) — never required for classifier-only mode
ANTHROPIC_API_KEY=

# Embeddings (Voyage or compatible). Leave empty to use local bge-large.
EMBEDDING_API_KEY=

# Org-mode API
DATABASE_URL=postgresql://sentryhulud:sentryhulud@localhost:5432/sentryhulud
SENTRYHULUD_API_URL=http://127.0.0.1:3001
SENTRYHULUD_API_TOKEN=

# Evaluation pin: must remain no-chaindrop for the frozen experiment
SENTRYHULUD_CORPUS_VERSION=no-chaindrop

# Action / policy
SENTRYHULUD_FAIL_OPEN=false

# Do not put real NPM_TOKEN or GITHUB_TOKEN here for sandbox testing.
